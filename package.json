{
  "name": "wanderlux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev": "pnpm start",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "serve": "node --env-file-if-exists=.env dist/server/server/index.js",
    "format": "prettier --write src shared server vite.config.ts index.html package.json"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "8.7.4",
    "leaflet": "1.9.4",
    "lucide-react": "^1.72.0",
    "openai": "^7.55.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8"
  }
}
