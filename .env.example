# Use the complete v1 endpoint, for example https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_ENDPOINT=
# This is the deployment name in your Azure resource, not necessarily a model ID.
AZURE_OPENAI_DEPLOYMENT=gpt-6-luna
# Leave this blank if the key is already supplied through your shell environment.
AZURE_OPENAI_API_KEY=
PORT=3001
# Keep local runs on loopback. Render sets HOST to 0.0.0.0.
HOST=127.0.0.1
# Optional Photon search endpoint. The public demo is for modest local use.
PHOTON_ENDPOINT=https://photon.komoot.io/api/
